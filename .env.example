# Nomor owner dalam format internasional, hanya digit (tanpa + atau spasi).
OWNER_NUMBER=62123456789

AUTO_REPLY_ENABLED=true
AUTO_REPLY_MESSAGE="Halo, pesan lu sudah diterima. Mika belum bisa jawab sekarang, tunggu sebentar ya."
AUTO_REPLY_MIN_DELAY=500
AUTO_REPLY_MAX_DELAY=1000
AUTO_REPLY_COOLDOWN=300000
# Path sticker WebP yang dikirim sebagai auto reply. Kosongkan untuk memakai pesan teks.

# AI lokal gratis via Ollama (tidak memerlukan API key)
AI_PROVIDER=gemini

# Gemini API free tier: buat key di Google AI Studio, lalu isi di sini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
ANTIGRAVITY_AGENT=antigravity-preview-05-2026
# Antrean global Gemini; bukan cooldown per pengguna.
GEMINI_MIN_REQUEST_INTERVAL_MS=8000

# Direktori kontak lokal dari file vCard. Nama dipakai hanya untuk konteks chat aktif.
CONTACTS_ENABLED=false
CONTACTS_VCF_FILE=

# OpenAI API (berbayar sesuai pemakaian). Jangan bagikan atau commit API key ini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Ollama hanya dipakai jika AI_PROVIDER=ollama.
AI_ENABLED=false
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:1.5b
AI_SYSTEM_PROMPT="Kamu adalah asisten WhatsApp yang ramah dan profesional. Jawab singkat dalam Bahasa Indonesia. Jika tidak yakin, katakan akan diteruskan ke pemilik. Jangan mengaku sebagai manusia."
# Optional: point to your own private persona file. Do not commit it.
AI_SYSTEM_PROMPT_FILE=
AI_MAX_HISTORY=6
AI_MAX_REPLY_CHARS=700
# Token internal Gemini untuk jawaban + reasoning. Jangan terlalu kecil agar kalimat tidak terputus.
AI_MAX_OUTPUT_TOKENS=1024
# Untuk chat cepat: minimal | low | medium | high
AI_THINKING_LEVEL=low
# Waktu maksimal menunggu model lokal dimuat/menjawab (milidetik).
AI_TIMEOUT_MS=120000

# Balasan AI di grup. Secara aman, hanya balas bila akun bot di-mention.
GROUP_AI_ENABLED=true
GROUP_REPLY_ON_MENTION_ONLY=true

# GIF lokal opsional. Isi assets/gifs dengan file MP4 pendek sesuai nama suasana.
MOOD_GIF_ENABLED=false
MOOD_GIF_COOLDOWN=21600000

# Ringkasan bencana nasional dari BMKG, dikirim hanya ke OWNER.
DISASTER_ALERTS_ENABLED=true
DISASTER_ALERT_INTERVAL_MS=3600000

# Backup server lengkap ke Discord webhook: kode, .env, sesi WhatsApp, data, dan file kontak.
# Gunakan channel Discord privat karena ZIP berisi kredensial dan sesi WhatsApp.
DISCORD_BACKUP_ENABLED=false
DISCORD_BACKUP_WEBHOOK_URL=
DISCORD_BACKUP_INTERVAL_MS=86400000

NOTIFY_OWNER_ENABLED=true
MESSAGE_MAPPING_TTL=86400000

# Batas reconnect sementara. Setelah itu proses berhenti agar tidak loop tanpa akhir.
RECONNECT_MAX_ATTEMPTS=8
RECONNECT_BASE_DELAY=2000
